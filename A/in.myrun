################################################################################
# @ben.wyj
################################################################################

seed                12345
dimension           3

global              gridcut 0.1 comm/sort yes surfmax 600

boundary            o o o

create_box          -6.0 6.0 -3.0 3.0 -3.0 3.0

create_grid         400 200 200

balance_grid        rcb cell

global              nrho 1988853763234101.2 fnum 124303360202.13133 temp 843.9547538030391

species             air.species N O N2 O2
mixture             air N O N2 O2 vstream -7748.491583849195 0.0 0.0

read_surf           data.goce_validation_16000
#
surf_collide        1 cll 400 0.82 0.82 0.0 0.0 partial 0.99999 
surf_collide        2 cll 400 0.82 0.82 0.0 0.0 partial 0.99999 
surf_modify         all collide 1 
# 
# 


collide             vss air air.vss # none

fix                 in emit/face air xhi twopass 

timestep            0.00001 # 0.0001 # 0.00001

### compute forces
# compute             1 surf all all fx shx shy shz px py pz press # fx shx shy shz px press
compute             1 surf all all fx fy fz shx shy shz px py pz press 
fix                 1 ave/surf all 1 4500 5000 c_1[*] 	# 10 200 2000 c_1[*]
## compute Fd
compute             2 surf all all fx
fix                 2 ave/surf all 1 100 100 c_2[*] 	# 10 200 2000 c_1[*]
compute             3 reduce sum f_2[*]                             # Fx
### compute Flift
# compute             4 surf all all fz
# fix                 3 ave/surf all 1 100 100 c_4[*] 	# 10 200 2000 c_1[*]
# compute             5 reduce sum f_3[*]                             # Fz
### compute temp->KE_system
# compute             6 temp 


### dumps
dump                1 surf all 5000 dump.myrun.* id f_1[*] # not type!


stats               100
# stats_style         step cpu c_3 c_5 np c_6 # (Fd, Flift, N_particles, Temp_system)
# stats_style         step cpu np # (Fd, Flift, N_particles, Temp_system)
stats_style         step cpu np c_3 # (Fd)
run                 5000 # 50000
